generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  github   GithubAccount?
  projects Project[]
}

model GithubAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUserId String
  username     String
  accessToken  String   // later encrypt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  name             String
  repoFullName     String   // e.g. "facebook/react"
  productionBranch String   @default("main")

  // Auto-detected Project Type (hidden from users)
  projectType      ProjectType @default(MONOREPO)

  // Workspace info
  workspacePath    String?  // Absolute path on backend
  cloneStatus      CloneStatus @default(PENDING)

  // Frontend Config (null if not applicable)
  frontendRoot      String?
  frontendFramework String?
  frontendBuildCmd  String?
  frontendOutputDir String?
  frontendNodeVersion String? @default("18")

  // Backend Config (null if not applicable)
  backendRoot       String?
  backendRuntime    String?  // node, python
  backendStartCmd   String?
  backendPort       Int?
  backendPackageManager String?

  // Deployment Settings
  autoDeployEnabled Boolean @default(true)

  // Relations
  deployments      Deployment[]
  branchConfigs    BranchConfig[]
  envVariables     EnvVariable[]
  domains          Domain[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum ProjectType {
  MONOREPO       // Has both frontend and backend
  FRONTEND_ONLY  // Static site or SPA
  BACKEND_ONLY   // API or server
}

enum CloneStatus {
  PENDING
  CLONING
  CLONED
  FAILED
}

model Deployment {
  id         String @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Git Info
  commitHash    String
  commitMessage String?
  branch        String

  // Status
  status        DeploymentStatus @default(QUEUED)
  url           String? // Assigned URL

  // Build Info
  buildStarted  DateTime?
  buildFinished DateTime?
  buildDuration Int? // seconds
  buildLogs     String? @db.Text

  // Deployment Info
  deployedAt    DateTime?

  // Errors
  errorMessage  String? @db.Text

  // Type
  deploymentType DeploymentType @default(PREVIEW)

  // Docker Info (generated internally)
  dockerfileBackendContent  String? @db.Text
  dockerfileFrontendContent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DeploymentStatus {
  QUEUED
  CLONING
  ANALYZING
  BUILDING
  DEPLOYING
  READY
  ERROR
  CANCELLED
}

enum DeploymentType {
  PRODUCTION
  PREVIEW
}

model BranchConfig {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  branchName        String
  autoDeployEnabled Boolean @default(false)
  isProduction      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, branchName])
}

model EnvVariable {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key       String
  value     String // TODO: Encrypt in production

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model Domain {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  domain    String @unique
  verified  Boolean @default(false)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
