generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  github   GithubAccount?
  projects Project[]
  projectGroups ProjectGroup[]
  databases Database[]
}

model GithubAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUserId String
  username     String
  accessToken  String   // later encrypt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectGroup {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  slug          String   @unique  // Subdomain identifier (e.g., "my-app" -> my-app.domain.com)
  apiPathPrefix String   @default("/api")  // Configurable API route prefix

  // Relations - max 1 frontend, 1 backend, 1 database per project
  projects      Project[]
  database      Database?  // Optional 1:1 relation to database

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId   String?
  group     ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Role within the project group (FRONTEND or BACKEND)
  role      ProjectRole?

  name             String
  repoFullName     String   // e.g. "facebook/react"
  branch           String   @default("main")
  framework        String?  // e.g. "react", "node", "python-flask"
  deploymentStatus String   @default("IDLE") // IDLE, BUILDING, DEPLOYED, FAILED
  
  // Workspace info
  workspacePath    String?  // Absolute path on backend
  frontendRoot     String?  // Relative path to workspace root
  backendRoot      String?  // Relative path to workspace root
  cloneStatus      String   @default("PENDING") // PENDING, CLONED, FAILED

  // Analysis / Build Config
  analysisStatus   String   @default("PENDING") // PENDING, ANALYZED, FAILED
  runtime          String?  // node, python, static, docker
  packageManager   String?  // npm, yarn, pnpm, pip
  buildCommand     String?
  startCommand     String?
  outputDir        String?
  port             Int?     @default(3000)
  
  // Docker Info
  dockerfileGenerated Boolean @default(false)
  
  deployType              DeployType       @default(BACKEND)
  dockerfileBackendContent String?
  dockerfileFrontendContent String?
  dockerfileBackendSource  DockerfileSource @default(GENERATED)
  dockerfileFrontendSource DockerfileSource @default(GENERATED)
  generatorVersion         String?

  // Static Deployment Props
  slug             String?  @unique
  rootDir          String   @default("/")

  // Backend persistent storage
  staticFolder     String?  // Folder name for static files (e.g., "uploads", "media", "files")
  uploadsVolume    String?  // Docker volume name for persistent uploads 

  deployments      Deployment[]
  envVars          EnvVar[]

  // Database relation (optional 1:1)
  database         Database? @relation(fields: [databaseId], references: [id], onDelete: SetNull)
  databaseId       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@unique([groupId, role])  // Only one frontend and one backend per project group
}

model Deployment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status    String   @default("QUEUED") // QUEUED, CLONING, BUILDING, FINALIZING, DEPLOYED, FAILED
  logs      String?  // Text

  createdAt DateTime @default(now())
  finishedAt DateTime?
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  key       String
  value     String
  
  @@unique([projectId, key])
}

enum DeployType {
  BACKEND
  FRONTEND
  FULLSTACK
}

enum ProjectRole {
  FRONTEND
  BACKEND
}

enum DockerfileSource {
  GENERATED
  USER_EDITED
}

enum DatabaseType {
  MYSQL
  POSTGRES
  MONGODB
  SQLITE
}

enum DatabaseStatus {
  CREATING
  RUNNING
  STOPPED
  ERROR
  FAILED
  DELETING
}

model Database {
  id            String   @id @default(cuid())
  userId        String   // Keep for backward compatibility and easy user-level queries
  name          String   // User-friendly name (e.g., "My App Database")

  // Project Group relation (new: database belongs to a project group)
  groupId       String?  @unique  // Optional for backward compat, unique = max 1 DB per group
  group         ProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Technical Details
  containerName String   @unique // Docker container name (e.g., "db-myapp-7x9k")
  type          DatabaseType // MYSQL, POSTGRES, MONGODB
  version       String   @default("8") // MySQL 8, Postgres 15, etc.

  // Database Credentials
  dbName        String   // Database name inside container
  dbUsername          String   @map("username") // Dedicated app user (unique per DB instance)
  dbPasswordEncrypted String   @map("password") // Encrypted at rest (may be plaintext for legacy rows)
  rootPasswordEncrypted String @map("rootPassword") // Encrypted at rest (never exposed to user)

  // Connection Details
  host          String   // Container name (for internal connections)
  port          Int      // 3306 for MySQL, 5432 for Postgres, 27017 for MongoDB

  // Status & Metadata
  status        DatabaseStatus @default(CREATING)
  volumeName    String   // Docker volume name for persistence
  diskUsageMB   Int      @default(0) // Storage used in MB
  linkedProjectId String? // Optional denormalized link (keep in sync with Project.databaseId)

  // SQLite-specific fields (only used when type = SQLITE)
  filePath          String?   // Path to the .db file (within project or uploaded location)
  sourceProjectId   String?   // If SQLite file is inside a deployed project
  uploadedFileName  String?   // Original filename if uploaded by user

  // Provisioning / Error Diagnostics
  lastError         String?
  lastProvisionLog  String?
  provisioningLog   Json?

  // Relationships
  project       Project?

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastAccessedAt DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
}
