generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  github   GithubAccount?
  projects Project[]
}

model GithubAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUserId String
  username     String
  accessToken  String   // later encrypt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  repoFullName     String   // e.g. "facebook/react"
  branch           String   @default("main")
  framework        String?  // e.g. "react", "node", "python-flask"
  deploymentStatus String   @default("IDLE") // IDLE, BUILDING, DEPLOYED, FAILED
  
  // Workspace info
  workspacePath    String?  // Absolute path on backend
  frontendRoot     String?  // Relative path to workspace root
  backendRoot      String?  // Relative path to workspace root
  cloneStatus      String   @default("PENDING") // PENDING, CLONED, FAILED

  // Analysis / Build Config
  analysisStatus   String   @default("PENDING") // PENDING, ANALYZED, FAILED
  runtime          String?  // node, python, static, docker
  packageManager   String?  // npm, yarn, pnpm, pip
  buildCommand     String?
  startCommand     String?
  outputDir        String?
  port             Int?     @default(3000)
  
  // Docker Info
  dockerfileGenerated Boolean @default(false)
  
  deployType              DeployType       @default(BACKEND)
  dockerfileBackendContent String? // @db.Text is implied for String in Prisma unless specified length, but usually Text in Postgres
  dockerfileFrontendContent String?
  dockerfileBackendSource  DockerfileSource @default(GENERATED)
  dockerfileFrontendSource DockerfileSource @default(GENERATED)
  generatorVersion         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum DeployType {
  BACKEND
  FRONTEND
  FULLSTACK
}

enum DockerfileSource {
  GENERATED
  USER_EDITED
}
